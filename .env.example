# Resend API key for the contact form (https://resend.com/api-keys).
# Without it, /api/contact returns 500 "Email service not configured".
RESEND_API_KEY=re_your_api_key_here

# Optional. The default sender, onboarding@resend.dev, only delivers to the Resend
# account owner's address. Use an address on a domain verified in Resend.
# CONTACT_FROM="Portfolio Contact <contact@yourdomain.com>"
# CONTACT_TO=you@example.com
